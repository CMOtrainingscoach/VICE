# Supabase (never commit real secrets)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: Supabase CLI (Account → Access Tokens), for link/db push without browser login
# SUPABASE_ACCESS_TOKEN=

# One-time bootstrap: Supabase Auth user UUID for Hardwig (after first signup in dashboard or seed)
VICE_BOOTSTRAP_ADMIN_USER_ID=

# App URL for auth redirects (local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (Blogger-koppeling per klant)
# Maak een OAuth 2.0 Client ID (Web) in Google Cloud Console.
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/integrations/blogger/callback
# Schakel Blogger API v3 in voor het project.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Meeting STT (demo/synthetic only until EU residency confirmed)
# OPENAI_API_KEY=
# VICE_STT_MODEL=whisper-1
# VICE_DELETE_AUDIO_AFTER_TRANSCRIBE=true
# Meeting-samenvatting (1 call per analyse): mini houdt kosten laag
# VICE_ANALYSIS_MODEL=gpt-4o-mini
#
# PESTEL AI-onderzoek (6 calls per volledige run, 1 per perspectief):
# Default in code: gpt-4o. Zet wat op jouw OpenAI-dashboard staat, bv.:
#   gpt-4o        — aanbevolen balans kwaliteit/kosten
#   gpt-4.1       — sterker redeneren indien beschikbaar op je account
#   gpt-4o-mini   — goedkoper, minder betrouwbare bronnen/externe nuance
# VICE_PESTEL_RESEARCH_MODEL=gpt-4o
# VICE_PESTEL_RESEARCH_MAX_TOKENS=4096
# VICE_PESTEL_SYNTHESIS_MODEL=gpt-4o-mini
#
# PESTEL live webonderzoek (verplicht voor «Onderzoek de markt met AI»):
# TAVILY_API_KEY=           # aanbevolen — https://tavily.com (gratis tier)
# SERPER_API_KEY=           # optioneel fallback (Google via serper.dev)
# Zonder Tavily/Serper gebruikt VICE OpenAI web_search (zelfde OPENAI_API_KEY, duurder)
# VICE_PESTEL_WEB_SEARCH_COUNTRY=BE
#
# Porter AI (5 calls per volledige run, 1 per kracht — zelfde Tavily/OpenAI als PESTEL):
# VICE_PORTER_RESEARCH_MODEL=gpt-4o
# VICE_PORTER_RESEARCH_MAX_TOKENS=4096
# VICE_PORTER_SYNTHESIS_MODEL=gpt-4o-mini
# 5C-analyse: geen webtools, enkel bestaande bronnen (default gpt-4o)
# VICE_FIVE_C_MODEL=gpt-4o
# VICE_SWOT_MODEL=gpt-4o
# VICE_VRIO_MODEL=gpt-4o
# VICE_BCG_MODEL=gpt-4o
# VICE_VALUE_CHAIN_MODEL=gpt-4o
# STP: geen webtools, enkel bestaande bronnen (default gpt-4o)
# VICE_STP_MODEL=gpt-4o
# Persona's en klantreis: tekst zonder webtools (default gpt-4o)
# VICE_PERSONA_MODEL=gpt-4o
# Portretten: server-side beeldprovider, geen dossier in de prompt
# VICE_PERSONA_IMAGE_MODEL=gpt-image-1
# VICE_PERSONA_PORTRAIT_DAILY_LIMIT=12
# Brand audit: tekst en beeld uit aangeleverde bronnen, geen verzonnen scans
# VICE_BRAND_MODEL=gpt-4o
# Publieke vermeldingen hergebruiken TAVILY_API_KEY of SERPER_API_KEY. Zonder sleutel blijft die stap leeg.
