# Supabase (never commit real secrets)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: Supabase CLI (Account → Access Tokens), for link/db push without browser login
# SUPABASE_ACCESS_TOKEN=

# One-time bootstrap: Supabase Auth user UUID for Hardwig (after first signup in dashboard or seed)
VICE_BOOTSTRAP_ADMIN_USER_ID=

# App URL for auth redirects (local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (sitekoppelingen per klant: Blogger, Search Console, Analytics)
# Maak een OAuth 2.0 Client ID (Web) in Google Cloud Console.
# Authorized redirect URIs (zelfde client ID voor alle koppelingen):
#   {NEXT_PUBLIC_APP_URL}/api/integrations/blogger/callback
#   {NEXT_PUBLIC_APP_URL}/api/integrations/search-console/callback
#   {NEXT_PUBLIC_APP_URL}/api/integrations/google-analytics/callback
#   {NEXT_PUBLIC_APP_URL}/api/integrations/google-ads/callback
# APIs inschakelen: Blogger API v3, Google Search Console API, Google Analytics Admin API, Google Ads API
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Dagelijkse metrics-sync (Vercel Cron → /api/cron/metrics)
# CRON_SECRET=
#
# Google Ads API (platform-breed, Keyword Planner — koppel in app: Instellingen → Platform · Google Ads)
# Zelfde GCP-project: Google Ads API inschakelen, toegang via Cloud Console → Overview (Test/Explorer).
# GOOGLE_ADS_CUSTOMER_ID=          # optioneel fallback; voorkeur: opslaan in Instellingen na koppelen
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=    # optioneel MCC (ook in Instellingen)
# GOOGLE_ADS_REFRESH_TOKEN=        # optioneel fallback; voorkeur: OAuth-koppeling in Instellingen
# GOOGLE_ADS_DEVELOPER_TOKEN=      # optioneel; leeg = placeholder header (Cloud-toegang)

# Beeldgeneratie (blog + social)
# VICE_IMAGE_PROVIDER=gemini   # openai | gemini (default: gemini als GEMINI_API_KEY gezet is)
# GEMINI_API_KEY=              # Google AI Studio / Generative Language API key
# VICE_GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# VICE_GEMINI_IMAGE_SIZE=1K    # 1K | 2K | 4K
# VICE_BLOG_IMAGE_MODEL=gpt-image-1   # alleen bij VICE_IMAGE_PROVIDER=openai

# Meeting STT (demo/synthetic only until EU residency confirmed)
# OPENAI_API_KEY=
# VICE_STT_MODEL=whisper-1
# VICE_DELETE_AUDIO_AFTER_TRANSCRIBE=true
# Meeting-samenvatting (1 call per analyse): mini houdt kosten laag
# VICE_ANALYSIS_MODEL=gpt-4o-mini
#
# PESTEL AI-onderzoek (6 calls per volledige run, 1 per perspectief):
# Default in code: gpt-4o. Zet wat op jouw OpenAI-dashboard staat, bv.:
#   gpt-4o        — aanbevolen balans kwaliteit/kosten
#   gpt-4.1       — sterker redeneren indien beschikbaar op je account
#   gpt-4o-mini   — goedkoper, minder betrouwbare bronnen/externe nuance
# VICE_PESTEL_RESEARCH_MODEL=gpt-4o
# VICE_PESTEL_RESEARCH_MAX_TOKENS=4096
# VICE_PESTEL_SYNTHESIS_MODEL=gpt-4o-mini
#
# PESTEL live webonderzoek (verplicht voor «Onderzoek de markt met AI»):
# TAVILY_API_KEY=           # aanbevolen — https://tavily.com (gratis tier)
# SERPER_API_KEY=           # optioneel fallback (Google via serper.dev)
# Zonder Tavily/Serper gebruikt VICE OpenAI web_search (zelfde OPENAI_API_KEY, duurder)
# VICE_PESTEL_WEB_SEARCH_COUNTRY=BE
#
# Porter AI (5 calls per volledige run, 1 per kracht — zelfde Tavily/OpenAI als PESTEL):
# VICE_PORTER_RESEARCH_MODEL=gpt-4o
# VICE_PORTER_RESEARCH_MAX_TOKENS=4096
# VICE_PORTER_SYNTHESIS_MODEL=gpt-4o-mini
# 5C-analyse: geen webtools, enkel bestaande bronnen (default gpt-4o)
# VICE_FIVE_C_MODEL=gpt-4o
# VICE_SWOT_MODEL=gpt-4o
# VICE_VRIO_MODEL=gpt-4o
# VICE_BCG_MODEL=gpt-4o
# VICE_VALUE_CHAIN_MODEL=gpt-4o
# STP: geen webtools, enkel bestaande bronnen (default gpt-4o)
# VICE_STP_MODEL=gpt-4o
# Persona's en klantreis: tekst zonder webtools (default gpt-4o)
# VICE_PERSONA_MODEL=gpt-4o
# Portretten: server-side beeldprovider, geen dossier in de prompt
# VICE_PERSONA_IMAGE_MODEL=gpt-image-1
# VICE_PERSONA_PORTRAIT_DAILY_LIMIT=12
# Brand audit: tekst en beeld uit aangeleverde bronnen, geen verzonnen scans
# VICE_BRAND_MODEL=gpt-4o
# Publieke vermeldingen hergebruiken TAVILY_API_KEY of SERPER_API_KEY. Zonder sleutel blijft die stap leeg.
#
# Leadgen (prospect research — eigen nav naast Content, /klanten/{id}/leadgen)
# LEADGEN_FIXTURES=true          # demodata zonder migratie/worker
# LEADGEN_MAX_RESULTS=30
# LEADGEN_MIN_RADIUS_KM=5
# LEADGEN_MAX_RADIUS_KM=100
# VICE_LEADGEN_MODEL=gpt-4o-mini
# TAVILY_API_KEY= of SERPER_API_KEY=   # verplicht voor echte zoekruns (anders status failed)
# SUPABASE_SERVICE_ROLE_KEY=           # worker schrijft via service role
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=   # Maps JS + Places autocomplete (beperk op origin)
# GOOGLE_MAPS_API_KEY=               # server-side Geocoding (zelfde key mag, restrictie op server-IP)
# CRON_SECRET=                       # optioneel; zonder secret draait worker direct na start (after())
# Leadgen worker: geen Vercel Cron op Hobby (max 1x/dag). Start bij run-aanmaak + open queued run-pagina.
# Optioneel handmatig/cron extern: GET /api/cron/leadgen?runId=... met Authorization: Bearer CRON_SECRET
