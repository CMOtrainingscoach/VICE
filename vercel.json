{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "crons": [
    {
      "path": "/api/cron/metrics",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/leadgen",
      "schedule": "*/5 * * * *"
    }
  ]
}
